<script>
  document.addEventListener("DOMContentLoaded", function () {
    const headers = Array.from(document.querySelectorAll(".toc-header"));
    const sections = Array.from(document.querySelectorAll(".right-pane > section"));

    // Map: sectionId -> header element
    const headerByTarget = new Map(
      headers.map(h => [h.dataset.target, h])
    );

    function activateSection(targetId, pushHash = false) {
      const targetSection = document.getElementById(targetId);
      const targetHeader  = headerByTarget.get(targetId);

      if (!targetSection || !targetHeader) {
        console.warn("No matching section/header for:", targetId);
        return;
      }

      // Deactivate all
      sections.forEach(s => s.classList.remove("active"));
      headers.forEach(h => h.classList.remove("active"));

      // Activate selected
      targetSection.classList.add("active");
      targetHeader.classList.add("active");

      if (pushHash) {
        // Keep URL in sync for deep-links/back/forward
        history.pushState(null, "", "#" + targetId);
      }
    }

    // Initial activation: URL hash > existing .active > first section
    const hashId = decodeURIComponent(location.hash.replace(/^#/, ""));
    const activeOnLoad =
      (hashId && document.getElementById(hashId)) ? hashId :
      (document.querySelector(".right-pane > section.active")?.id) ||
      (sections[0]?.id);

    if (activeOnLoad) activateSection(activeOnLoad, false);

    // Click handlers
    headers.forEach(header => {
      header.addEventListener("click", () => {
        const targetId = header.getAttribute("data-target");
        if (targetId) activateSection(targetId, true);
      });
    });

    // Support navigating directly to #core-competencies etc.
    window.addEventListener("hashchange", () => {
      const newId = decodeURIComponent(location.hash.replace(/^#/, ""));
      if (newId) activateSection(newId, false);
    });
  });
</script>

