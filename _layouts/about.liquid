---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="row justify-content-center">
      <!-- Left Anchor Nav (hidden on mobile) -->
      <nav class="col-md-2 d-none d-md-block">
        <div class="nav flex-column sticky-top">
          <a class="nav-link" href="#program-overview">Program Overview</a>
          <a class="nav-link" href="#how-it-works">How It Works</a>
          <!-- <a class="nav-link" href="#">How to Apply</a> --> 
        </div>
      </nav>

      <!-- Main Content -->
      <div class="col-12 col-md-7 mt-3 mt-md-0">
        {{ content }}
      </div>

      <!-- Right-side CTA Cards -->
      <div class="col-md-3 mt-4 mt-md-0">
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title">Register</h5>
            <p class="card-text">Sign up to join the CIP-Fellows program.</p>
            <a href="#" class="btn btn-primary">Go to Registration</a>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title">Inquire Here</h5>
            <p class="card-text">For more further details about the CIP program, please provide a few details through this information form and we will get in contact with you directly.</p>
            <a href="#" class="btn btn-primary">Inquire Here</a>
          </div>
        </div>
      </div>
  </article>
</div>