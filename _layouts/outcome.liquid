---
layout: default
---
<ul style="list-style: none; padding-left: 0;">
  {% for o in site.outcomes %}
    <li>
        <div class="fellow-outcome">
            <a href="{{ o.url }}" style="color: white;">{{ o.title }}</a>
            <a href="/projects/{{ o.project }}/">{{ o.project | replace: "-", " " | capitalize }}</a>
            {% if o.summary %}
                — {{ o.summary }}
            {% endif %}
        </div>
    </li>
  {% endfor %}
</ul>
