---
layout: default
---

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="container mt-4">
<hr class="my-4 fellow-divider">

<h1 class="text-uppercase fellow-name">{{ page.title }}</h1>
    

  <!-- Left: Image, institute, class year -->
  <div class="row mt-4">
    <!-- Left: Image and Metadata -->
    <div class="col-md-4 text-center">
      {% if page.img %}
        <img src="{{ page.img | relative_url }}" alt="{{ page.title }}" class="img-fluid rounded mb-3" style="max-height: 300px;">
      {% endif %}
    </div>

    <!-- Right: Contact and special info content -->
    <div class="col-md-8">
      <h3 class="fellow-type">CIP {{ page.fellow-type }} {{ page.category }} </h3>

      {% if page.institute %}
        <h4 class="text-muted font-italic mb-1">{{ page.institute }}</h4>
      {% endif %}

      <br>

      <div class="contact-list">
        {% if page.voice %}
          <div class="contact-label">Voice:</div>
          <div class="contact-value">{{ page.voice }}</div>
        {% endif %}
        {% if page.email %}
          <div class="contact-label">Email:</div>
          <div class="contact-value"><a href="mailto:{{ page.email }}?subject=CIP Fellows"> {{ page.email }} </a></div>
        {% endif %}
        {% if page.LinkedIn %}
          <div class="contact-label">LinkedIn:</div>
          <div class="contact-value"><a href="{{ page.LinkedIn }}" target="_blank"> {{ page.LinkedIn }}</a></div>
        {% endif %}
        {% if page.orcid %}
          <div class="contact-label">ORCID:</div>
          <div class="contact-value"><a href="https://orcid.org/{{ page.orcid }}" target="_blank">{{ page.orcid }}</a></div>
        {% endif %}
        {% if page.Github %}
          <div class="contact-label">Github: </div>
          <div class="contact-value"><a href="{{ page.Github }}" target="_blank"> {{ page.Github }} </a></div>
        {% endif %}
        {% if page.other %}
          <div class="contact-label">Other:</div>
          <div class="contact-value">{{ page.other }}</div>
        {% endif %}
      </div>
    </div>
  </div>

  <hr class="my-4 fellow-divider">

  <div class="col-md-12">
    <article>
      {{ content }}
    </article>
  </div>

  <hr class="my-4 fellow-divider">

  {% assign my_outcomes = site.outcomes | where: "fellow", page.title %}
  {% if my_outcomes and my_outcomes.size > 0 %}
    <div class="fellow-outcomes-list">
      {% for o in my_outcomes %}
        <a href="{{ o.url }}" style="text-decoration: none; color: inherit;">
          <div class="fellow-outcome hover-card">
            <h3 class="post-title">{{ o.title }}</h3>
            {% if o.summary %}
              <p style="padding-bottom: 0; margin-bottom: 0;">{{ o.summary }}</p>
            {% endif %}
            {% if o.tags %}
              <br>
              <p class="post-tags outcome" style="padding-bottom: 0; margin-bottom: 0;">
                {% for t in o.tags %}
                  <a class="tag-pill" href="/outcomes/tag/{{ t | uri_escape }}/"># {{ t }}</a>
                {% endfor %}
              </p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}


  {% if page.related_publications %}
    <h2 class="mt-5">References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
