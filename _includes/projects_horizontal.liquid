<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 100vw, 50vw" alt="project thumbnail" class="card-img-top" %}
      {% endif %}
      <div class="card-body">
        <h3 class="card-title">{{ project.title }}</h3>
        {% if project.institute %}
          <h6 class="card-subtitle mb-2 text-muted">{{ project.institute }}</h6>
        {% endif %}
        {% if project.description %}
          <p class="card-text">{{ project.description }}</p>
        {% endif %}
      </div>
    </div>
  </a>
</div>
