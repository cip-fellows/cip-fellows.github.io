<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable {% if page.url == '/cip-fellows/' %}cip-fellow-card{% endif %}">
      {% if project.img %}
        <div class="card-img-wrapper">
          {% include figure.liquid
            loading="eager"
            path=project.img
            sizes="250px"
            alt="project thumbnail"
            class="card-img-fixed"
          %}
        </div>
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        {% if project.institute %}
          <h4 class="card-subtitle mb-2 card-institute">{{ project.institute }}</h4>
        {% endif %}
        <p class="card-text" style="color: white;">{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>
